# Nova Credit AI — Environment Configuration Example
# Copy this file to .env and set your environment-specific values

APP_NAME="Nova Credit AI"
APP_VERSION="2.2.0"
DEBUG=false
ENVIRONMENT=development

# Database Configuration (SQLite default; use postgresql://user:pass@host/db in production)
DATABASE_URL="sqlite:///./data/nova_credit.db"

# Security & Authentication (Generate a strong 32+ character random string for production)
SECRET_KEY="nova-secure-random-secret-key-change-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional Initial Admin Bootstrap (Used only by backend bootstrap script if needed)
ADMIN_BOOTSTRAP_EMAIL="admin@novacredit.ai"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMeInProduction123!"

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:8085,http://127.0.0.1:8085"

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
